# Set environment variables in your shell; Django does not auto-load this file.
# Local development defaults to SQLite. Production must set DJANGO_DEBUG=0 and DATABASE_URL.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=development-only-change-before-deploying
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Local PostgreSQL is optional; DATABASE_URL takes precedence over SQLite.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/hamkharid
# Production example (do not commit the real value):
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# FRONTEND_URL=https://your-frontend.vercel.app
# SECURE_HSTS_SECONDS=31536000
