# Set environment variables in your shell; Django does not auto-load this file.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# PostgreSQL (the default database backend)
POSTGRES_DB=hamkharid
POSTGRES_USER=hamkharid
POSTGRES_PASSWORD=hamkharid
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Alternatively: DATABASE_URL=postgresql://user:password@host:5432/database
# Production requires DJANGO_DEBUG=0 and a unique DJANGO_SECRET_KEY.
